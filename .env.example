# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STORE_NAME=AURA Minimalist Living
